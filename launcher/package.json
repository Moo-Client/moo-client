{
  "name": "moo-client-launcher",
  "version": "1.9.3",
  "description": "Moo Client Launcher — Premium Minecraft Client inspired by Lunar Client",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --dir && node patch-icon.js && electron-builder --win nsis-web --prepackaged dist/win-unpacked",
    "publish": "electron-builder --win --publish always"
  },
  "author": "MooTeam",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2"
  },
  "dependencies": {
    "minecraft-launcher-core": "^3.18.1",
    "msmc": "^5.0.5",
    "node-fetch": "^2.7.0",
    "pngjs": "^7.0.0",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.mooclient.launcher",
    "productName": "Moo Client",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis-web",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "sign": null
    },
    "nsisWeb": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Moo Client",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "uninstallDisplayName": "Moo Client ${version}",
      "allowElevation": true,
      "perMachine": false,
      "artifactName": "MooClient-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Moo Client",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "uninstallDisplayName": "Moo Client ${version}",
      "allowElevation": true,
      "perMachine": false
    },
    "publish": {
      "provider": "github",
      "owner": "Moo-Client",
      "repo": "moo-client"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}